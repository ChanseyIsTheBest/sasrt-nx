#version 450

// sasrt-nx: the raw 32-bit words of a depth resolve, (depth24 << 8) | stencil with the depth as 20e4 (D24FS8) or
// unorm24 (D24S8), in an RGBA8 image whose texel bytes are the bytes of the word (R = bits 0-7, the stencil). That is
// what a texture fetch of the resolved depth as k_8_8_8_8 reads on Xenos. Sonic & All-Stars Racing Transformed restores
// its G-buffer depth into EDRAM that way: it samples the resolve as 8888 and draws the words into a color target whose
// tiles alias the depth target's. Same encoding as me_edram_depth_to_rgba8.comp, without the tile mapping (a resolve
// is linear in pixels). Runs with the depth resolve, from the same depth and stencil aspect views.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D source_depth;
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D target;
layout(set = 0, binding = 2) uniform usampler2D source_stencil;
layout(push_constant) uniform Constants {
  uvec2 source_size, target_size;
  uvec2 offset_source, offset_target;
  uvec2 extent;
  float guest_factor;  // host depth -> guest depth: 2 for the half-range D32 of D24FS8 targets
  uint depth_format;   // 0 D24S8, 1 D24FS8
} c;

uint A20e4(float z) {
  if (!(z > 0.0)) return 0u;  // Also rejects NaN and negative zero.
  uint bits = floatBitsToUint(z);
  if (bits >= 0x3FFFFFF8u) return 0xFFFFFFu;
  if (bits < 0x38800000u) {
    bits = ((bits & 0x7FFFFFu) | 0x800000u) >> min(113u - (bits >> 23u), 24u);
  } else {
    bits += 0xC8000000u;
  }
  return (bits >> 3u) & 0xFFFFFFu;
}

void main() {
  uvec2 q = gl_GlobalInvocationID.xy;
  if (any(greaterThanEqual(q, c.extent))) return;
  uvec2 src = q + c.offset_source, dst = q + c.offset_target;
  if (any(greaterThanEqual(src, c.source_size)) || any(greaterThanEqual(dst, c.target_size))) return;
  float z = texelFetch(source_depth, ivec2(src), 0).r * c.guest_factor;
  uint depth = c.depth_format == 0u ? uint(roundEven(clamp(z, 0.0, 1.0) * 16777215.0)) : A20e4(z);
  uint word = (depth << 8u) | (texelFetch(source_stencil, ivec2(src), 0).r & 255u);
  uvec4 bytes = uvec4(word, word >> 8u, word >> 16u, word >> 24u) & 255u;
  imageStore(target, ivec2(dst), vec4(bytes) * (1.0 / 255.0));
}
