+void QueueCapturedRun(u32 device_va, u32 command_buffer_va, std::shared_ptr<CapturedRun> captured) {
+  if (!captured) {
+    QueueRunCommandBuffer(device_va, command_buffer_va);
+    return;
+  }
+  FlushDeferredVertices(device_va);
+  const u8 *device = GuestPtr<const u8>(device_va);
+  if (!device)
+    return;
+  struct Run {
+    std::vector<u8> running;  // the running device, whose constants the buffer inherits
+    std::shared_ptr<CapturedRun> captured;
+    std::shared_ptr<SasrtStreamCopies> copies;  // sasrt-nx (sasrt_renut_capture_recorded_streams)
+  };
