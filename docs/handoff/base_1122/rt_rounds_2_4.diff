+    g_sasrt_stream_copies = run->copies.get();  // sasrt-nx (sasrt_renut_capture_recorded_streams)
+    SasrtSeqNoteRun(true);  // sasrt-nx (2026-11-08, sasrt_renut_diag_depth_writers)
