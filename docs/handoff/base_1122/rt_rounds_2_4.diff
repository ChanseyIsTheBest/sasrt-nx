+  run->captured = std::move(captured);
+  if (SasrtCaptureStreamsOn()) {  // sasrt-nx (2026-10-21, sasrt_renut_capture_recorded_streams): copied now
+    // Per stream (GPU address): its size, the stride its draws read it with (~0u: they differ, so all of it) and
+    // the vertex ranges they read (PrepareGeometry's: base vertex plus the lowest to the highest index).
+    struct Want {
+      u32 size = 0, stride = 0;
+      std::vector<std::pair<u32, u32>> ranges;  // [first, last] vertex
+    };
+    std::unordered_map<u32, Want> wants;
+    for (const auto &[buffer_va, buffer] : run->captured->buffers) {
+      if (!buffer)
+        continue;
+      for (const Op &op : buffer->ops) {
+        if (op.kind != OpKind::Draw || !op.sasrt_ranges.count)
+          continue;
+        u32 first = 0, last = ~0u;  // ~0u: unknown, the whole stream
+        if (!op.call.tessellation && op.call.count) {
+          if (!op.call.indexed) {
+            first = op.call.start_vertex;
+            last = first + op.call.count - 1;
+          } else {
+            const u8 *src = nullptr;
+            bool is32 = false;
+            u32 endian = 0;
+            if (op.call.up_indices != kNoUp) {  // as Replay (CallOf)
+              is32 = op.call.up_indices_32;
+              endian = is32 ? 2 : 1;
+              src = buffer->arena.data() + op.call.up_indices + size_t(op.call.start_index) * (is32 ? 4 : 2);
+            } else if (op.ib_va) {
