+// sasrt-nx (2026-11-09 night, the memory report's new CPU line, run mem13: the 63 recorded buffers held 247 MB of
+// capacity for 29-47 MB of recordings: a new recording takes a spare buffer whatever its capacity, up to kMaxKeptArena
+// (8 MB), and keeps it). At the game's EndCommandBuffer, on the recording thread (nothing replays the recording before
+// it is ended, nor holds a pointer into its arena: ops hold offsets), a vector with more than 1 MB past three times what
+// it holds goes down to that plus a quarter: one copy of what was recorded. A buffer recorded every frame at a steady
+// size stays (its capacity is within three times its size after the first such cut).
+REXCVAR_DEFINE_BOOL(sasrt_cmdbuf_trim_ended, true, "SASRT/Graphics",
+                    "A recorded command buffer whose capacity is more than three times what it holds (and 1 MB more) is "
+                    "cut to what it holds plus a quarter when the game ends the recording (run mem13: 247 MB of capacity "
+                    "for 29-47 MB recorded); the same commands")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+// sasrt-nx (2026-11-10): the cut's ratio (percent of what the recording holds) and the slack past it, as keys to tune
+// (run mem16: 22-30 MB recorded in 106 MB of capacity with 300 % and 1 MB).
+REXCVAR_DEFINE_INT32(sasrt_cmdbuf_trim_percent, 300, "SASRT/Graphics",
+                     "sasrt_cmdbuf_trim_ended: a recording's vector is cut when its capacity is past this percent of "
+                     "what it holds (and sasrt_cmdbuf_trim_slack_kb more)")
+    .range(110, 10000)
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+REXCVAR_DEFINE_INT32(sasrt_cmdbuf_trim_slack_kb, 1024, "SASRT/Graphics",
+                     "sasrt_cmdbuf_trim_ended: the capacity past the ratio before a cut, in KB")
+    .range(16, 1048576)
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+template <typename V>
+size_t TrimEnded(V &v) {
+  static const size_t percent = size_t(REXCVAR_GET(sasrt_cmdbuf_trim_percent));
+  static const size_t slack = size_t(REXCVAR_GET(sasrt_cmdbuf_trim_slack_kb)) << 10;
+  const size_t elem = sizeof(typename V::value_type);
+  const size_t size = v.size(), cap = v.capacity();
+  const size_t limit = size * percent / 100;
+  if (cap <= limit || (cap - limit) * elem < slack)
+    return 0;
+  V cut;
+  cut.reserve(size + size / 4);
+  cut.insert(cut.end(), v.begin(), v.end());
+  const size_t freed = (cap - cut.capacity()) * elem;
+  v.swap(cut);
+  return freed;
+}
