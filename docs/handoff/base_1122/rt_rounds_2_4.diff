+                last = u32(int64_t(op.call.base_vertex) + hi);
+              }
+            }
+          }
+        }
+        for (u32 i = 0; i < op.sasrt_ranges.count; ++i) {
+          if (op.sasrt_ranges.stream[i] == 0 && op.call.up_vertices != kNoUp)
+            continue;  // its own copy
+          Want &want = wants[op.sasrt_ranges.va[i]];
+          want.size = std::max(want.size, op.sasrt_ranges.size[i]);
+          const u32 stride = op.sasrt_ranges.stride[i];
+          if (!stride || last == ~0u)
+            want.stride = ~0u;
+          else if (want.stride != ~0u && want.stride != stride)
+            want.stride = want.stride ? ~0u : stride;
+          if (want.stride != ~0u)
