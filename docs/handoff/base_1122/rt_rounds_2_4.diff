+                    v = __builtin_bswap32(v);
+                  else if (endian == 1)
+                    v = ((v & 0x00FF00FFu) << 8) | ((v >> 8) & 0x00FF00FFu);
+                  else if (endian == 3)
+                    v = (v >> 16) | (v << 16);
+                } else {
+                  uint16_t h;
+                  std::memcpy(&h, src + k * 2, 2);
+                  v = (endian == 1 || endian == 2) ? __builtin_bswap16(h) : h;  // as ReadIndices
+                }
+                lo = std::min(lo, v);
+                hi = std::max(hi, v);
