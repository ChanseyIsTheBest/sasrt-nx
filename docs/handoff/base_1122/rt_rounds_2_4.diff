+      copy.size = want.size;
+      if (want.stride == ~0u || want.ranges.empty()) {
+        std::memcpy(copy.data.get(), p, want.size);
+        copied += want.size;
+        continue;
+      }
+      copy.stride = want.stride;
+      std::sort(want.ranges.begin(), want.ranges.end());
+      uint64_t end = 0;  // bytes copied so far from the start of the stream
+      for (const auto &[a, b] : want.ranges) {
+        uint64_t from = std::max<uint64_t>(uint64_t(a) * want.stride, end);
+        const uint64_t to = std::min<uint64_t>((uint64_t(b) + 1) * want.stride, want.size);
+        if (from < to) {
+          std::memcpy(copy.data.get() + from, p + from, size_t(to - from));
+          copied += to - from;
+          end = to;
+        }
