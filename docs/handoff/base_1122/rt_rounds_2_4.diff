+void SasrtCountStreamCopies(const SasrtStreamCopies &copies, uint64_t copied) {
+  static std::atomic<uint64_t> runs{0}, streams{0}, bytes{0}, spanned{0};
+  uint64_t b = 0;
+  for (const auto &entry : copies)
+    b += entry.second.size;
+  streams += copies.size();
+  bytes += copied;
+  spanned += b;
+  const uint64_t n = ++runs;
+  if (n % 600 == 0)
+    RGPU_INFO("[sasrt] recorded runs' vertex streams copied at their submission: {} runs, {} streams, {:.1f} MB "
+              "copied of {:.1f} MB they span (sasrt_renut_capture_recorded_streams)", n, streams.load(),
+              bytes.load() / 1048576.0, spanned.load() / 1048576.0);
+}
