+    uint64_t copied = 0;
+    for (auto &[stream_va, want] : wants) {
+      const u8 *p = GuestPhysicalPtr<const u8>(stream_va);
+      if (!p || !want.size)
+        continue;
+      // 12:40: whole streams only, up to 2 MB (the ranges left bytes some draws read unfilled: a PC race drew
+      // planes across the screen in most frames); a bigger stream is read from guest memory, as without the key.
+      if (want.size > (2u << 20))
+        continue;
+      want.stride = ~0u;
+      SasrtStreamCopy &copy = (*copies)[stream_va];
