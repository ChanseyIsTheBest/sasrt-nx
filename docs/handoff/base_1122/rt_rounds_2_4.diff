+// The bound vertex streams of a draw being recorded (the ones copied at the submission), with their strides.
+void SasrtNoteStreamRanges(const u8 *bytes, SasrtStreamHashes &out) {
+  out.count = 0;
+  for (u32 s = 0; s < 16u && out.count < 4; ++s) {
+    if (!u32(*reinterpret_cast<const be_u32 *>(bytes + d3d::kDeviceOffsetStreamSources + s * 4)))
+      continue;
+    const u8 *w = bytes + offsetof(d3d::Device, m_Constants) +
+                  (d3d::kFirstVertexFetchIndex + d3d::StreamFetchIndex(s)) * 8;
+    const u32 w0 = *reinterpret_cast<const be_u32 *>(w), w1 = *reinterpret_cast<const be_u32 *>(w + 4);
+    const u32 va = w0 & ~3u, size = w1 & 0x3FFFFFCu;
+    if (!va || !size)
+      continue;
+    out.va[out.count] = va;
+    out.size[out.count] = size;
+    out.stream[out.count] = s;
+    out.stride[out.count] = u32(bytes[d3d::kDeviceOffsetStreamStrides + s]) * 4;
+    ++out.count;
+  }
+}
